<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lsh.account.mapper.AccountMapper">
    <resultMap id="AccountResultMap" type="com.lsh.account.entity.Account">
        <id property="accountId" column="account_id"/>
        <result property="customerId" column="customer_id"/>
        <result property="accountNumber" column="account_number"/>
        <result property="accountType" column="account_type"/>
        <result property="currency" column="currency"/>
        <result property="totalBalance" column="total_balance"/>
        <result property="availableBalance" column="available_balance"/>
        <result property="frozenAmount" column="frozen_amount"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectById" resultMap="AccountResultMap">
        SELECT * FROM account WHERE account_id = #{accountId}
    </select>
    <select id="selectByAccountNumber" resultMap="AccountResultMap">
        SELECT * FROM account WHERE account_number = #{accountNumber}
    </select>
    <select id="selectAll" resultMap="AccountResultMap">
        SELECT * FROM account
    </select>
    <select id="selectByCustomerId" resultMap="AccountResultMap">
        SELECT * FROM account WHERE customer_id = #{customerId}
    </select>
    <update id="freezeAmount">
        UPDATE account SET frozen_amount = frozen_amount + #{amount}, available_balance = available_balance - #{amount}
        WHERE account_id = #{accountId} AND available_balance &gt;= #{amount}
    </update>
    <update id="unfreezeAmount">
        UPDATE account SET frozen_amount = frozen_amount - #{amount}, available_balance = available_balance + #{amount}
        WHERE account_id = #{accountId} AND frozen_amount &gt;= #{amount}
    </update>
    <update id="debit">
        UPDATE account SET total_balance = total_balance - #{amount}, frozen_balance = frozen_balance - #{amount}
        WHERE account_id = #{accountId} AND frozen_balance &gt;= #{amount}
    </update>
    <update id="credit">
        UPDATE account SET total_balance = total_balance + #{amount}, available_balance = available_balance + #{amount}
        WHERE account_id = #{accountId}
    </update>
</mapper> 